{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "orchestrator-workers",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-29",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"ai": { "binding": "AI" },
	"vars": {
		"STAGEHAND_SERVICE_URL": "http://localhost:8788",
		"GITHUB_OWNER": "devnull03"
	},
	"workflows": [
		{ "name": "orchestrator-workers-workflow", "binding": "ORCHESTRATOR_WORKERS_WORKFLOW", "class_name": "OrchestratorWorkersWorkflow" },
		{ "name": "website-automation-workflow", "binding": "WEBSITE_AUTOMATION_WORKFLOW", "class_name": "WebsiteAutomationWorkflow" }
	]
}
